+  private String getDayLabel(int dayNum) {
+    return switch (dayNum) {
+      case 0 -> "ПН";
+      case 1 -> "ВТ";
+      case 2 -> "СР";
+      case 3 -> "ЧТ";
+      case 4 -> "ПТ";
+      case 5 -> "СБ";
+      default -> "";
+    };
+  }
+
+  private int findDayStartRow(Elements rows, int startIndex, String dayLabel) throws Exception {
+    for (int i = startIndex; i < rows.size(); i++) {
+      if (hasDayLabel(rows.get(i), dayLabel)) return i;
+    }
+
+    throw new Exception("Строка расписания для дня не найдена");
+  }
+
+  private int findNextDayStartRow(Elements rows, int startIndex) {
+    for (int i = startIndex; i < rows.size(); i++) {
+      if (hasAnyDayLabel(rows.get(i))) return i;
+    }
+
+    return rows.size();
+  }
+
+  private boolean hasAnyDayLabel(Element row) {
+    for (String dayLabel : List.of("ПН", "ВТ", "СР", "ЧТ", "ПТ", "СБ")) {
+      if (hasDayLabel(row, dayLabel)) return true;
+    }
+
+    return false;
+  }
 
